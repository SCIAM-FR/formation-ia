# Copier en .env (ignoré par git) et renseigner. Le script scripts/preparer-demo.sh complète les CLE_* s'elles sont vides.
# Clé OpenCode Zen : opencode.ai/zen → facturation → clé API. C'est la seule clé de fournisseur de la démo.
OPENCODE_API_KEY=cle-opencode-zen
# Le conteneur agentgateway écrit la base SQLite dans ./data avec votre identité : id -u ; id -g
DEMO_UID=501
DEMO_GID=20
# Clés virtuelles des équipes (générées par le script : openssl rand -hex 24, préfixe sk-agw-). Laisser vide au départ.
CLE_PLATFORM=
CLE_PRODUIT_A=
CLE_PRODUIT_B=
CLE_CI=
CLE_DEMO=
# SSO de démonstration (Keycloak local)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=remplacer
# Secret du client OIDC « agentgateway-ui » : injecté dans le realm Keycloak à l'import ET lu par agentgateway (config.yaml).
# À fixer AVANT le premier démarrage de Keycloak : le realm n'est importé qu'une fois (voir README, « SSO avec Keycloak »).
KEYCLOAK_CLIENT_SECRET=remplacer-par-une-valeur-aleatoire
# Clé AES-256 de chiffrement du cookie de session de l'interface (obligatoire dès qu'une politique oidc existe) : openssl rand -hex 32
OIDC_COOKIE_SECRET=remplacer-par-64-caracteres-hexadecimaux
