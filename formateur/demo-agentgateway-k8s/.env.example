# Copier en .env (ignoré par git) et renseigner. Lu par scripts/installer.sh.
# Clé OpenCode Zen : opencode.ai/zen → facturation → clé API. C'est la seule clé de fournisseur de la démo ;
# elle est mise dans le Secret Kubernetes « zen-secret », jamais dans un manifeste.
OPENCODE_API_KEY=cle-opencode-zen
# Mot de passe admin de la console Keycloak de démonstration (http://localhost:8180/admin, compte admin)
KEYCLOAK_ADMIN_PASSWORD=remplacer
# Nom du cluster kind créé par le script (kind/cluster.yaml)
KIND_CLUSTER=formation-ia
