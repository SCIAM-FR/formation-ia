# Copier en .env (ignoré par git) et renseigner. Générer les clés : openssl rand -hex 32
LITELLM_MASTER_KEY=sk-remplacer-par-une-valeur-aleatoire
LITELLM_SALT_KEY=sk-remplacer-par-une-autre-valeur-aleatoire
POSTGRES_PASSWORD=remplacer
# Clé OpenCode Zen : opencode.ai/zen → facturation → clé API. C'est la seule clé de fournisseur de la démo.
OPENCODE_API_KEY=cle-opencode-zen
UI_USERNAME=admin
UI_PASSWORD=remplacer
# SSO de démonstration (Keycloak local)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=remplacer
# Doit être identique au champ "secret" du client litellm dans keycloak/realm-formation-ia.json
KEYCLOAK_CLIENT_SECRET=remplacer-par-une-valeur-aleatoire
